# =============================================================================
# E-TİCARET MARKETPLACE - ORTAM DEĞİŞKENLERİ ÖRNEK DOSYASI
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre ayarlayın.
# .env dosyası GIT'e eklenmemelidir (güvenlik için)
# =============================================================================

# Sunucu Ayarları
PORT=3001
NODE_ENV=development

# Veritabanı Ayarları (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eticaret_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT (JSON Web Token) Ayarları
# Güçlü ve rastgele bir anahtar kullanın
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (CORS için)
CLIENT_URL=http://localhost:5173

# Komisyon Oranı (%)
COMMISSION_RATE=5

# Moderasyon Ayarları
# Perspective API için (isteğe bağlı)
# PERSPECTIVE_API_KEY=your_api_key_here
